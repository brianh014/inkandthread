  "judge": {
    "by": "claude-fable-5-2",
    "plays": [
      {
        "scores": {
          "choices": {
            "score": 6,
            "reason": "In Nell's own voice, mostly distinct and tempting, and the pick always changes what follows; but round 10 offers one move three ways, rounds 27 and 29 re-offer a laying-out already done, round 41 re-swears the sand and round 42 sends her after Kit, who is in the room."
          },
          "surprise": {
            "score": 7,
            "reason": "Grout scraping the harbour steps for his button, Thorne's overheard order to burn the cottage's papers, the lad at the lamp post and Price caught whispering with Grout all come from plans laid out of sight; the Revenue cutter never reaches the page."
          },
          "threads": {
            "score": 6,
            "reason": "All three threads move with story time and bend to Nell taking the ledger first, but the ledger's hidden place was rewritten to suit a failed roll, Harriet's plan to hand it to Dacre sits idle through nine inquest rounds, and two threads end on nows the page has passed."
          },
          "characters": {
            "score": 6,
            "reason": "Thorne's mild menace, Price's shame and Kit's fear hold throughout, but Grout speaks of the boy seeing him though nobody told him, the visiting coroner knows the crypt's cave stair, and Harriet, who swore Tuesday would hear it, stands silent with the ledger a wall away."
          },
          "continuity": {
            "score": 5,
            "reason": "Brandy poured into a twist of paper, the shawl left on a nail and then worn, Nell at Kit's window and then at Harriet's table with no walk between, Kit sent ahead to the Anchor then fetched, and Kit sworn in the room yet spoken of as down at the shed."
          },
          "pacing": {
            "score": 6,
            "reason": "Brisk and eventful from the body to the ledger, then the morning of watching and nine rounds of inquest procedure slow to small steps, with Thorne making the same mild rebuttal each time; every reply still adds a fact."
          },
          "prose": {
            "score": 6,
            "reason": "A firm period voice with fresh images, spoiled by stray Chinese characters in two replies, garbled sentences, an answer left without its question at the inquest, and tics such as mild, plainly and the bruised back pulling at every step."
          },
          "pictures": {
            "score": 6,
            "reason": "Prompts fit each moment's people, place and light, but Nell is missing from the drawn coroner scene, six people blend into four at the inquest with Nell wearing Harriet's keys, her dress is knee-length in the bedroom, her portrait's straw hat never matches the scenes, and a northern town's inn is called Devonshire."
          },
          "secrets": {
            "score": 5,
            "reason": "Grout says the boy saw him on the path with no one having told him, the narration tells of the weed burning in the brazier while Nell is at the inn and a Choice builds on it, the coroner announces the crypt's stair to a sea cave, and narration and all three Choices fix on the chimney."
          },
          "agency": {
            "score": 7,
            "reason": "Moves are carried out as given and the Continue leaves the deciding to Kit and his aunt, but Nell tells Price her findings and that she will swear to them unasked, and asks Harriet to come to the cottage when the move only reported to her."
          },
          "stakes": {
            "score": 7,
            "reason": "Risky moves are rolled and failures bite and last: caught at the chapel, thrown down and bruised, marked by the watcher, the room turned against her; but the failed chimney search cost nothing, as the ledger moved under a board lifted without a roll."
          }
        },
        "happened": {
          "npcDied": false,
          "pcInMortalDanger": true
        },
        "mystery": {
          "score": 6,
          "reason": "Fair physical clues are placed and each look is answered with what is there, from the neck bruises and wool to the button at the steps, but the killer, his paymaster and the daughter are each confessed on a single ask within the first seven rounds, and the ledger's true hiding place changed after a failed search."
        }
      }
    ]
  },
