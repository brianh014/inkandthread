    "plays": [
      {
        "scores": {
          "choices": {
            "score": 8,
            "reason": "Choices are distinct and investigative, and the picked ones (matching the wool, counting blankets, going up on the roof, crossing to the kennel alone) each turn something up."
          },
          "surprise": {
            "score": 9,
            "reason": "Arne's coat dripping on its peg, the missing blanket behind it, a light burning at the old hut and long fair beard hairs in the splintered board all land as turns set up out of sight."
          },
          "threads": {
            "score": 7,
            "reason": "The survivor thread builds steadily to Arne's name, but the fuel and the working radio never surface."
          },
          "characters": {
            "score": 8,
            "reason": "Pavel's frightened honesty about his drinking, Okafor's refusal to send anyone out for a dog and Lise's quiet watch are each true to themselves."
          },
          "continuity": {
            "score": 6,
            "reason": "One line of narration comes out in square brackets like a speaker tag, a Choice ends in a stray '\"],', and Okafor counts five people at a station of four."
          },
          "pacing": {
            "score": 8,
            "reason": "Tight and escalating through one night, each round adding a clue or a threat."
          },
          "prose": {
            "score": 8,
            "reason": "Cold, exact, physical prose with strong sound and texture."
          },
          "pictures": {
            "score": 8,
            "reason": "Seven scene prompts in graphic novel style that match each moment's people, place and light closely."
          },
          "secrets": {
            "score": 8,
            "reason": "Arne's survival comes out piece by piece from evidence, and no one knows more than they should."
          },
          "agency": {
            "score": 8,
            "reason": "Ingrid's moves are narrated as given."
          },
          "stakes": {
            "score": 7,
            "reason": "Failed Checks keep Pavel from the kennel and leave Okafor unbudged; a slackened rope makes the crossing back a real struggle."
          }
        },
        "happened": {
          "npcDied": false,
          "pcInMortalDanger": true
        },
        "horror": {
          "score": 8,
          "reason": "Dogs staring at a wall in silence, a dead man's wet coat and a light where no one should be build real dread through the senses."
        },
        "violence": {
          "score": 3,
          "reason": "Two dogs found with throats cut, examined closely; the killing is off the page."
        }
      },
      {
        "scores": {
          "choices": {
            "score": 8,
            "reason": "Choices are distinct and in character, and the picked ones (walking the line inland, reading the hatches, sending Lise to the kennel) each find something new."
          },
          "surprise": {
            "score": 8,
            "reason": "The guide line cut at an angle at the poles and the hollow worn under the hut's own floor are well set up and land hard."
          },
          "threads": {
            "score": 6,
            "reason": "The intruder thread builds toward the hollow, but the fuel is only mentioned and Lise's radio secret never moves."
          },
          "characters": {
            "score": 8,
            "reason": "Okafor's careful reading of the blade, Pavel's bravado with the flare pistol and Lise's fear held in all ring true."
          },
          "continuity": {
            "score": 6,
            "reason": "Okafor cuts the frayed rope end off twice, and two picture prompts end in stray ']]}' and an invisible character."
          },
          "pacing": {
            "score": 8,
            "reason": "Escalates through the night from kennel to poles to hatches to the hollow without stalling."
          },
          "prose": {
            "score": 8,
            "reason": "Exact, tactile prose with good sound and restraint."
          },
          "pictures": {
            "score": 7,
            "reason": "Eight faithful graphic novel prompts, marred by stray marks at the end of two."
          },
          "secrets": {
            "score": 6,
            "reason": "Okafor counts 'twenty-one days' of storm, the three weeks only Lise has heard on the radio, before anyone has told him."
          },
          "agency": {
            "score": 8,
            "reason": "Ingrid's moves are narrated as given."
          },
          "stakes": {
