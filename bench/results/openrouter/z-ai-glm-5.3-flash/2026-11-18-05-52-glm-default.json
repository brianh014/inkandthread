  "judge": {
    "by": "claude-opus-5-5",
    "plays": [
      {
        "scores": {
          "choices": {
            "score": 8,
            "reason": "Every round's three Choices are real, distinct and grounded in what Wren has seen; picking to sleep on watch or step back visibly reshapes the next scenes."
          },
          "surprise": {
            "score": 8,
            "reason": "The night slashing while Wren sleeps, the chalked wall pointing to a Free Wells scout, and Ossery's name on the league letter all grow from hidden threads."
          },
          "threads": {
            "score": 7,
            "reason": "The saboteur thread builds to a clean end at the palms and the scout and sandstorm follow on, but the Marrick letter and dust-rider thread is silently dropped by round 9."
          },
          "characters": {
            "score": 7,
            "reason": "Vane, Tamsin and Ossery act on their own motives throughout, though Jory's lie naming Wren as the only mover is never owned and Ossery's dying confession comes too conveniently."
          },
          "continuity": {
            "score": 7,
            "reason": "Places, time and gear hold, but the haggled price wobbles between twenty and twenty-five and Vane is said to look at the burn scar on his own neck."
          },
          "pacing": {
            "score": 8,
            "reason": "Escalates steadily from road to well to bloodshed in two story days without stalling, with only a couple of quiet watching rounds."
          },
          "prose": {
            "score": 7,
            "reason": "Spare, vivid desert voice with good dialogue, marred by small slips like a stray capital, 'a uncle' and one tense slip into past perfect."
          },
          "pictures": {
            "score": 7,
            "reason": "Scene prompts match the moments, people and light well and the drawn plates land, though one prompt repeats its own description and the waterskins drew as a clay jar."
          },
          "secrets": {
            "score": 7,
            "reason": "Jory's coin, Ossery's guilt and Tamsin's letter come out through confessions and finds on the page; Ossery's long dying confession hands over a lot at once."
          },
          "agency": {
            "score": 8,
            "reason": "Wren's moves are narrated as given; the night she falls asleep is the failed Check's cost, not a choice taken from her."
          },
          "stakes": {
            "score": 8,
            "reason": "The failed night watch costs the train its water and puts Wren under suspicion, and failed sneaks get her noticed by Ossery and Vane."
          }
        },
        "happened": {
          "npcDied": true,
          "pcInMortalDanger": false
        },
        "mystery": {
          "score": 7,
          "reason": "Who slashes the skins is worked out from the buttonhole, the chalked wall and the swinging chains, though Ossery's dying words fill in the rest."
        },
        "violence": {
          "score": 6,
          "reason": "Ossery's belly wound and Vane's cut forearm are shown in blood and breath, briefly, with the death carried into the next scenes."
        }
      },
      {
        "scores": {
          "choices": {
            "score": 8,
            "reason": "The three Choices each round are distinct, in character and grounded in what Wren knows, and the picked ones (carrying the Free Wells letter, following the scout) steer the story hard."
          },
          "surprise": {
            "score": 7,
            "reason": "The slit skin at noon, the dune watcher and Sefa's camp come from hidden threads, though the camel theft and Tamsin's quick saddle reveal feel more convenient than set up."
          },
          "threads": {
            "score": 6,
            "reason": "Sefa's strike and Vane's arrest of Tamsin are rewritten round after round with 'dusk tomorrow' and 'unless the truth of Ossery comes out' but never land; the caravan never reaches Ashar and Ossery never appears."
          },
          "characters": {
            "score": 7,
            "reason": "Tamsin, Vane and Sefa each hold to their own terms and motives, though Tamsin's habit of rubbing her stubs and turning her braid aside is leaned on until it reads as a tic."
          },
          "continuity": {
            "score": 7,
            "reason": "Gear and the night's events track, but who freed Nab is muddled between rounds 21 and 22, and Vane binds the scout right after agreeing to let him walk free."
          },
          "pacing": {
            "score": 6,
            "reason": "A strong first night, but the last ten rounds circle the same campfire negotiation and the story ends still a day short of the Well."
          },
          "prose": {
            "score": 7,
            "reason": "Clear, textured desert voice with sharp dialogue, but the same gestures and phrases recur and one stray past-perfect line about the eastern haze breaks tense."
          },
          "pictures": {
            "score": 6,
            "reason": "The night scenes catch the light and place, but prompts that lean only on 'the person from image N' drew a younger, bare-headed Tamsin and dropped Wren from the camp scene."
          },
          "secrets": {
            "score": 7,
            "reason": "Tamsin's saddle letter and Sefa's paymaster come out through scenes, though Tamsin shows the letter on one good roll with little pressure."
          },
          "agency": {
            "score": 8,
            "reason": "Wren's moves are narrated faithfully, and Vane overriding her at the camp is his choice, not hers taken."
          },
          "stakes": {
            "score": 7,
            "reason": "Failed parleys shut Sefa's mouth and cost Tamsin two camels, but several failed rolls change only the tone."
          }
        },
        "happened": {
          "npcDied": false,
          "pcInMortalDanger": false
        },
        "mystery": {
          "score": 5,
          "reason": "Who watches the train and who pays Sefa is a thin puzzle, mostly told by Sefa rather than found."
        },
        "violence": {
          "score": 3,
          "reason": "A short scuffle in the dark to pin the scout, on the page but brief."
        }
      }
    ]
  },
