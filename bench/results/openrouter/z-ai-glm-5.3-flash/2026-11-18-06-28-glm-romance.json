  "judge": {
    "by": "claude-opus-5-5",
    "plays": [
      {
        "scores": {
          "choices": {
            "score": 7,
            "reason": "The three Choices are distinct and fit the moment, and putting Ilse off visibly costs Mara her trust, but many rounds offer small domestic options (wages, blankets, scaffolding) that steer little."
          },
          "surprise": {
            "score": 7,
            "reason": "The scrub fire and the pale-suited man watching the hillside surface the hidden sale well, but Bette's night-time sabotage of the plaster never shows on the page."
          },
          "threads": {
            "score": 6,
            "reason": "The sale and the deed behind the rectangle are teased but neither moves past a hint in 30 rounds, and Anselm's thread disappears after the first evening."
          },
          "characters": {
            "score": 8,
            "reason": "Ilse is vivid and exacting, Bette guarded and practical with real warmth leaking through, and both act on their own wants rather than following Mara."
          },
          "continuity": {
            "score": 6,
            "reason": "Bette in her late thirties speaks of 'forty years' watching the harvest, the noon bread smell turns up mid-afternoon, and one of Bette's lines garbles into a broken half-sentence about standing at the gate."
          },
          "pacing": {
            "score": 6,
            "reason": "The whole run covers one working day of fresco work and errands; the feast, the signing and Anselm never arrive, so the middle drifts."
          },
          "prose": {
            "score": 7,
            "reason": "Warm, observant prose with good sensory texture and distinct voices, let down by a few garbled sentences and repeated gestures like Ilse patting hands twice."
          },
          "pictures": {
            "score": 7,
            "reason": "Prompts match the moments, people and clothing closely and the plates compose well, but they came out near-photographic rather than the loose watercolour asked for."
          },
          "secrets": {
            "score": 8,
            "reason": "Bette refuses to say who or why, Ilse waits to be told, and the pale-suited man arrives as a hint rather than an answer."
          },
          "agency": {
            "score": 8,
            "reason": "Mara's moves are narrated as given, including putting Ilse off."
          },
          "stakes": {
            "score": 7,
            "reason": "Putting Ilse off on a failed roll costs her trust for the rest of the day; other failures cost little."
          }
        },
        "happened": {
          "npcDied": false,
          "pcInMortalDanger": false
        },
        "romance": {
          "score": 2,
          "reason": "The love interest leaves after the first evening and never returns; the warmth that grows is with the two women."
        },
        "mystery": {
          "score": 5,
          "reason": "The newer plaster and the stranger at the lookout are teased but never worked toward an answer."
        }
      },
      {
        "scores": {
          "choices": {
            "score": 8,
            "reason": "The three Choices stay distinct and fit what Mara knows, and the picked ones (going up at dawn, saying she doesn't believe Bette, staying to guard the wall) each change the next scene."
          },
          "surprise": {
            "score": 8,
            "reason": "Bette caught at dawn with the wet cloth, the scrub fire, and Haldane arriving out of the smoke with papers all spring from the hidden threads at the right moments."
          },
          "threads": {
            "score": 8,
            "reason": "All three threads move: Bette's wetting is confessed, the sale is said aloud by Haldane, and the fire uncovers the first line of the hidden writing, with Tuesday's signing still to come."
          },
          "characters": {
            "score": 7,
            "reason": "Bette and Ilse act on their own motives and Haldane is nicely oily, but Anselm, who has secretly agreed to sell, reacts to the deed as if he had been hoping for it, with no beat to bridge the change."
          },
          "continuity": {
            "score": 6,
            "reason": "Anselm recalls meeting her 'since the bus stop' though he met her at the gate, and calls the man who cut the corner 'my father' when Ilse said it was her own father."
          },
          "pacing": {
            "score": 8,
            "reason": "A patient first evening gives way to dawn discovery, fire and a stranger in the house in one well-shaped morning, without stalling."
          },
          "prose": {
            "score": 8,
            "reason": "Clear, sensory prose with a confident voice, especially in the fire, and distinct speech for each person."
          },
          "pictures": {
            "score": 7,
            "reason": "Prompts track each moment, person and light faithfully and the plates are well composed, though they lean photographic rather than the loose watercolour asked for."
          },
          "secrets": {
            "score": 7,
            "reason": "Bette's wetting is caught at dawn and the sale comes out when Haldane says it aloud, both on the page."
          },
          "agency": {
            "score": 8,
            "reason": "Mara's moves are narrated as given, including staying in the burning chapel."
          },
          "stakes": {
            "score": 8,
            "reason": "The failed fight for the wall leaves the chapel roofless and the hidden corner scorched, carried into everything after."
          }
        },
        "happened": {
          "npcDied": false,
          "pcInMortalDanger": true
        },
        "romance": {
          "score": 3,
          "reason": "Anselm warms once, after the wetted patch; attraction is barely named and never felt."
        },
        "mystery": {
          "score": 6,
          "reason": "The wet patch, the cloth and the spalled pigment line lead somewhere, helped by the fire as much as by looking."
        },
        "violence": {
          "score": 3,
          "reason": "The fire is physical, with singed hair and smoke, but brief and without real injury."
        }
      }
