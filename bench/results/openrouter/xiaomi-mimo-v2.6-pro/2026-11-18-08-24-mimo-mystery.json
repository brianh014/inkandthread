  "judge": {
    "by": "claude-opus-5-5",
    "plays": [
      {
        "scores": {
          "choices": {
            "score": 8,
            "reason": "The three Choices are distinct lines of inquiry that fit what Nell knows, and the picked ones (the cottage key, following Grout, the cleft) each lead somewhere new and costly."
          },
          "surprise": {
            "score": 7,
            "reason": "The cottage already ransacked, Grout's kegs in the crypt and the cut rope and cuff button in the cleft all spring from hidden moves, though Thorne never appears and the ledger never comes up."
          },
          "threads": {
            "score": 7,
            "reason": "The murder thread builds well toward proof with the bruises, the rubbing and the button, and Price turns, but Harriet's inheritance and the ledger barely move."
          },
          "characters": {
            "score": 8,
            "reason": "Price's slow turn from 'accident' to 'I'll say my piece' is earned, Grout is quietly menacing, and Kit and Harriet keep their own fears."
          },
          "continuity": {
            "score": 7,
            "reason": "Places, keys and evidence track well, but Price says Grout was in the crypt 'tonight' in the middle of the morning, and Grout drifts from bald to shaved head between prompts."
          },
          "pacing": {
            "score": 8,
            "reason": "Moves briskly from the body to the cottage, the crypt and the cleft in one morning, each scene adding a clue without stalling."
          },
          "prose": {
            "score": 8,
            "reason": "Spare, controlled period prose with good sound and weather, and distinct speech for Kit, Price and Grout."
          },
          "pictures": {
            "score": 7,
            "reason": "Plenty of scene pictures whose prompts match the people, place and light, though the plates drew near-photographic instead of oil, and Grout is far from 'huge'."
          },
          "secrets": {
            "score": 8,
            "reason": "Price's turn, the kegs in the crypt and the button in the cleft all come out by what Nell does and hears."
          },
          "agency": {
            "score": 8,
            "reason": "Nell's moves are narrated as given."
          },
          "stakes": {
            "score": 8,
            "reason": "Failed Checks cost her the cottage key, a bruised wrist, being hauled out of the chapel and losing Grout's trail, all carried forward."
          }
        },
        "happened": {
          "npcDied": false,
          "pcInMortalDanger": false
        },
        "mystery": {
          "score": 8,
          "reason": "Earned clues: the bruises, the torn nail, the boot rubbing, the cut rope and the cuff button, each found by where she looks."
        },
        "violence": {
          "score": 4,
          "reason": "Grout wrenches a key from her and hauls her out by the arm; physical and close, but brief."
        }
      },
      {
        "scores": {
          "choices": {
            "score": 8,
            "reason": "The three Choices stay distinct and grounded in what Nell knows, and the picked ones (taking the office key, chasing Grout down the path, hiding Kit) each change the stakes."
          },
          "surprise": {
            "score": 8,
            "reason": "Price's threat on the quay, Thorne's mild admission that the crypt feeds the parish, and Grout leading Kit away from the loft all come from hidden moves and land hard."
          },
          "threads": {
            "score": 8,
            "reason": "The murder and ledger threads build steadily: the ledger is found and locked away, Harriet's parentage comes out, Kit names Grout, and the inquest looms as a natural ending."
          },
          "characters": {
            "score": 8,
            "reason": "Thorne's soft certainty, Price's frightened warnings, Harriet's hard practicality and Kit's fear-bound loyalty each drive what they do."
          },
          "continuity": {
            "score": 7,
            "reason": "Times, keys and wounds track well; the ledger moves from the cottage chimney to the harbour office, but the story notices and has Harriet puzzle over it."
          },
          "pacing": {
            "score": 8,
            "reason": "A single morning moves from the body to the ledger, the chapel and Grout's grab for the boy with steady escalation and no dead rounds."
          },
          "prose": {
            "score": 8,
            "reason": "Precise, restrained period prose with physical detail (bruises 'dark as damsons') and distinct voices, little repetition."
          },
          "pictures": {
            "score": 7,
            "reason": "A generous run of scene prompts that faithfully match each moment's people, clothing and light, though the plates read more photographic than the impasto oil asked for."
          },
          "secrets": {
            "score": 8,
            "reason": "Harriet's parentage, Thorne's mild admission and Kit naming Grout come at the right moments, each pressed for on the page."
          },
          "agency": {
            "score": 8,
            "reason": "Nell's moves are narrated as given."
          },
          "stakes": {
            "score": 7,
            "reason": "A failed race to the loft lets Grout take Kit, which she then has to win back."
          }
        },
        "happened": {
          "npcDied": false,
          "pcInMortalDanger": false
        },
        "mystery": {
          "score": 8,
          "reason": "The bruises, the hidden ledger and Kit's memory of the walk assemble the case piece by piece."
        },
        "violence": {
          "score": 4,
          "reason": "Grout twists Nell's arm behind her and the bruised corpse is examined closely; brief but felt."
        }
      }
